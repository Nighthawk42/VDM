# Copy to .env. Environment variables override vdm.yaml.
VDM_ENVIRONMENT=development
VDM_DATA_DIR=data
VDM_HOST=127.0.0.1
VDM_PORT=8000
# Supply VDM_OPENROUTER_API_KEY through a secret manager, not this file in Git.
VDM_OPENROUTER_MODEL=openai/gpt-6-luna
VDM_JEV_MODEL=typesafe/jev-1.13
VDM_AUDIO_CPP_URL=http://127.0.0.1:8880
